# ===== 后端 LLM / Embedding（外部 SaaS，仅需密钥）=====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash-vision-exp
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBED_MODEL=text-embedding-v4
EMBED_DIMS=1024

# ===== MySQL =====
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_USER=root
# 演示用默认口令；端口仅绑定 127.0.0.1，不对外暴露。
# 正式部署请改成随机串，例：python -c "import secrets;print(secrets.token_urlsafe(16))"
MYSQL_PASSWORD=ragent_pass
MYSQL_DB=ragent_db
# 容器初始化用（与上方保持一致）
MYSQL_ROOT_PASSWORD=ragent_pass

# ===== Elasticsearch =====
# compose 中 ES 未开内置认证（演示用），故此处留空
ES_URL=http://es:9200
ES_USER=
ES_PASSWORD=

# ===== CORS（逗号分隔；nginx 同源代理时可留空）=====
# 禁止填 *：与 allow_credentials=True 组合会让任意站点带凭据跨域访问，服务会拒绝启动
CORS_ORIGINS=http://localhost:5173,http://localhost

# ===== 数据目录（容器内）=====
DATA_DIR=/app/data
