# ===== Backend LLM / Embedding (external SaaS, keys only) =====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash-vision-exp
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBED_MODEL=text-embedding-v4
EMBED_DIMS=1024

# ===== MySQL =====
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_USER=root
# Demo default password; the port binds 127.0.0.1 only and is never exposed.
# For a real deployment use a random string, e.g. python -c "import secrets;print(secrets.token_urlsafe(16))"
MYSQL_PASSWORD=ragent_pass
MYSQL_DB=ragent_db
# Used for container initialization (keep it identical to the value above)
MYSQL_ROOT_PASSWORD=ragent_pass

# ===== Elasticsearch =====
# ES runs without built-in auth in compose (demo setup), so leave this empty
ES_URL=http://es:9200
ES_USER=
ES_PASSWORD=

# ===== CORS (comma separated; may stay empty behind the same-origin nginx proxy) =====
# Never use *: together with allow_credentials=True any site could call this service with credentials,
# and startup is rejected
CORS_ORIGINS=http://localhost:5173,http://localhost

# ===== Data directory (inside the container) =====
DATA_DIR=/app/data
