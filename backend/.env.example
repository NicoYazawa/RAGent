# ========== Provider switching (provider phase 1) ==========
# LLM_PROVIDER options: deepseek / qwen / openai / moonshot / zhipu / siliconflow / ollama
LLM_PROVIDER=deepseek
# EMBED_PROVIDER options: qwen / openai / siliconflow / ollama (watch the dimensions! switching changes the
# vector dims, see the guard note at the end of this file; also clear any old EMBED_MODEL / EMBED_DIMS overrides below)
EMBED_PROVIDER=qwen
# Non-empty overrides the provider catalog base_url (self-hosted gateway / proxy setups; empty by default)
# LLM_BASE_URL=
# EMBED_BASE_URL=
# Non-empty overrides the catalog default model / dims (empty = use the catalog defaults)
# LLM_MODEL=
# EMBED_MODEL=
# EMBED_DIMS=

# ========== Provider keys (fill in only the two you enable) ==========
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
OPENAI_API_KEY=
MOONSHOT_API_KEY=
ZHIPU_API_KEY=
SILICONFLOW_API_KEY=
# ollama is keyless; run `ollama serve` locally first (default http://localhost:11434)

# ========== Legacy variables (same semantics, still supported) ==========
# DEEPSEEK_BASE_URL=    empty = use the catalog base_url (https://api.deepseek.com)
# DASHSCOPE_BASE_URL=   empty = use the catalog base_url (https://dashscope.aliyuncs.com/compatible-mode/v1)
# Note: these legacy variables win over the catalog base_url — clear them when switching
# LLM_PROVIDER / EMBED_PROVIDER, otherwise requests for the new provider keep pointing at the old base_url.

# ========== Rerank (off by default; when on, coarse retrieval widens the pool and rerank trims to top_n) ==========
# Benchmark comparison (backend/scripts/benchmark_retrieval.py, 60-question gold set):
#   Recall@5 0.933->0.967 / MRR 0.845->0.945 / nDCG@8 0.865->0.944, total latency 235->341ms
# RERANK_ENABLED=false
# RERANK_PROVIDER=qwen              # options: qwen (gte-rerank-v2) / siliconflow (bge-reranker-v2-m3)
# RERANK_MODEL=                     # empty = use the catalog default
# RERANK_BASE_URL=                  # empty = use the catalog default
# RERANK_TOP_N=8                    # chunks kept after reranking (context items handed to generation)
# RERANK_CANDIDATES=20              # coarse (RRF) candidate count; per-lane recall depth grows to candidates/2

# ========== MySQL 8.x =========
MYSQL_HOST=localhost
MYSQL_PORT=3306
# Non-root account used by the app (keep it consistent with the root .env)
MYSQL_USER=rag_app
MYSQL_PASSWORD=
MYSQL_DB=ragent_db

# ========== Elasticsearch 8.x =========
ES_URL=http://localhost:9200
ES_USER=elastic
ES_PASSWORD=

# ========== Application =========
CORS_ORIGINS=http://localhost:5173

# ---- Important: switching EMBED_PROVIDER changes the vector dimensions ----
# When the ES index dims do not match the provider, the startup self-check reports FAIL and /api/health
# returns degraded, leaving vector retrieval unusable. Rebuild the index and re-embed everything
# (a one-click rebuild arrives in provider phase 2).
