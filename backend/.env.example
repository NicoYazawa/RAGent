# ========== 供应商切换（Provider Phase 1）==========
# LLM_PROVIDER 可选：deepseek / qwen / openai / moonshot / zhipu / siliconflow / ollama
LLM_PROVIDER=deepseek
# EMBED_PROVIDER 可选：qwen / openai / siliconflow / ollama（注意维度！切换会改变向量维度，见文件末尾 guard 说明；并请一并清空下方 EMBED_MODEL / EMBED_DIMS 旧覆盖）
EMBED_PROVIDER=qwen
# 非空则覆盖厂商目录 base_url（自建网关 / 代理场景；默认留空）
# LLM_BASE_URL=
# EMBED_BASE_URL=
# 非空则覆盖目录默认模型 / 维度（默认留空 = 用目录默认值）
# LLM_MODEL=
# EMBED_MODEL=
# EMBED_DIMS=

# ========== 各供应商密钥（只填当前启用的两家即可）==========
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
OPENAI_API_KEY=
MOONSHOT_API_KEY=
ZHIPU_API_KEY=
SILICONFLOW_API_KEY=
# ollama 免密钥，本地需先 ollama serve（默认 http://localhost:11434）

# ========== 兼容旧变量（语义不变，可继续使用）==========
# DEEPSEEK_BASE_URL=    留空 = 用目录 base_url（https://api.deepseek.com）
# DASHSCOPE_BASE_URL=   留空 = 用目录 base_url（https://dashscope.aliyuncs.com/compatible-mode/v1）
# 注意：这两个 legacy 变量优先级高于目录 base_url——切换 LLM_PROVIDER / EMBED_PROVIDER 后请一并清空，
# 否则新供应商的请求仍会被指向旧 base_url。

# ========== Rerank 精排（默认关；开启后 粗排扩候选 → 精排截 top_n）==========
# 基准对比（backend/scripts/benchmark_retrieval.py，金标准集 60 题）：
#   Recall@5 0.933→0.967 / MRR 0.845→0.945 / nDCG@8 0.865→0.944，总延迟 235→341ms
# RERANK_ENABLED=false
# RERANK_PROVIDER=qwen              # 可选：qwen（gte-rerank-v2）/ siliconflow（bge-reranker-v2-m3）
# RERANK_MODEL=                     # 留空 = 用目录默认
# RERANK_BASE_URL=                  # 留空 = 用目录默认
# RERANK_TOP_N=8                    # 精排后保留片段数（送入生成的上下文条数）
# RERANK_CANDIDATES=20              # 粗排（RRF）候选数；单路召回深度自动扩为 candidates/2

# ========== MySQL 8.x =========
MYSQL_HOST=localhost
MYSQL_PORT=3306
# 应用用非 root 账号（与根目录 .env 保持一致）
MYSQL_USER=rag_app
MYSQL_PASSWORD=
MYSQL_DB=ragent_db

# ========== Elasticsearch 8.x =========
ES_URL=http://localhost:9200
ES_USER=elastic
ES_PASSWORD=

# ========== 应用 =========
CORS_ORIGINS=http://localhost:5173

# ---- 重要：切换 EMBED_PROVIDER 会改变向量维度 ----
# ES 索引维度与供应商不一致时启动自检报 FAIL、/api/health 返回 degraded，
# 向量检索不可用。需重建索引并全量重新向量化（一键重建将在 Provider Phase 2 提供）。
